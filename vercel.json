{
  "rewrites": [
    { "source": "/auth/:path*", "destination": "https://mariageplus-production-a657.up.railway.app/auth/:path*" },
    { "source": "/api/:path*", "destination": "https://mariageplus-production-a657.up.railway.app/api/:path*" },
    { "source": "/(.*)", "destination": "/" }
  ],
  "headers": [
    { "source": "/auth/:path*", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/api/:path*", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
